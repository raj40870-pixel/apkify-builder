# Backend API URL (for production frontend)
VITE_API_URL=https://apkify-backend-studio.ai.studio

# MongoDB Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/appifynow

# JWT Secret for Auth
JWT_SECRET=super_secret_jwt_key_change_in_production

# Email Settings (for OTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Google reCAPTCHA v3
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key
VITE_RECAPTCHA_SITE_KEY=your_recaptcha_site_key

# Cloudflare Turnstile Secret Key (Legacy/Alternative)
# TURNSTILE_SECRET_KEY=
